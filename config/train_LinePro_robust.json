{
    "seed": 2023,
    "save_dir": "experiments_model/",
    "train_data_loader": {
        "name": "custom_list",
        "use_list": true,
        "video_list": "./data_list/mixed_imgs_train_filter40.txt",
        "mask_list": "./data_list/irregular_mask_40_50.txt",
        "line_list": "./data_list/mixed_pkls_train_filter40.txt",
        "flow_list": "",
        "w": 256,
        "h": 256,
        "num_local_frames": 10,
        "num_ref_frames": 6,
        "load_flow": 0,
        "line_width": 1,
        "line_swap_xy": true,
        "line_invert_y": true,
        "mask_match_mode": "frame_index",
        "flow_root": "unused_when_load_flow_is_0",
        "line_train_aug": true,
        "return_clean_line_for_loss": true,
        "line_dropout_prob": 0.1,
        "line_hole_empty_prob": 0.1,
        "line_hole_dropout_prob": 0.3,
        "line_hole_dropout_keep": 0.7,
        "line_shift_prob": 0.2,
        "line_shift_max": 2,
        "line_dilate_prob": 0.1,
        "line_erode_prob": 0.1,
        "line_morph_kernel": 3,
        "line_noise_prob": 0.05,
        "line_noise_density": 0.001
    },
    "losses": {
        "hole_weight": 1,
        "valid_weight": 1,
        "flow_weight": 1,
        "adversarial_weight": 0.0,
        "GAN_LOSS": "hinge",
        "perceptual_weight": 0.05,
        "line_weighted_weight": 0.0,
        "line_loss_alpha": 3.0,
        "sobel_weight": 0.0,
        "sobel_line_alpha": 2.0,
        "laplacian_weight": 0.01
    },
    "model": {
        "net": "propainter",
        "no_dis": 1,
        "load_d": 0,
        "interp_mode": "nearest"
    },
    "trainer": {
        "version": "trainer",
        "type": "Adam",
        "beta1": 0,
        "beta2": 0.99,
        "lr": 5e-05,
        "batch_size": 1,
        "num_workers": 8,
        "num_prefetch_queue": 4,
        "log_freq": 50,
        "save_freq": 5000,
        "iterations": 50000,
        "scheduler": {
            "type": "MultiStepLR",
            "milestones": [
                40000
            ],
            "gamma": 0.1
        },
        "gen_path": "./experiments_model/propainter_train_LinePro_finetune/gen_015000.pth"
    },
    "line_guidance_weight": 0.75
}